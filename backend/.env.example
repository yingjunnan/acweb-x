# Local default (SQLite)
DATABASE_URL=sqlite+aiosqlite:///./acweb.db

# PostgreSQL (local Docker or remote DB)
# DATABASE_URL=postgresql+asyncpg://acweb:acweb_dev_pw@localhost:5432/acweb

# DB bootstrap retry settings (useful when DB container starts slower than API)
DB_INIT_RETRIES=30
DB_INIT_RETRY_DELAY=1.0

# 1 = auto create missing tables on startup (good for local/dev)
# 0 = require explicit migration (recommended for stricter environments)
AUTO_CREATE_TABLES=1
